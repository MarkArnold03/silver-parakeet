{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Booking": {
    "SellableVolumeRatio": 0.85,
    "CutoffTime": "18:00",
    "LinkValidityDaysAfterDelivery": 7,
    "TruckFillWarnRatio": 0.9
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "LoginsPerMinutePerIp": 10
  },
  "CustomerLinks": {
    "BaseUrl": "http://localhost:5173",
    "HardExpiryDays": 120
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "ParakeetDeliveryBooking/0.1",
    "TimeoutSeconds": 5
  }
}
