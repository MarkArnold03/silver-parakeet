  "components": {
    "schemas": {
      "AddressRequest": {
        "required": [
          "street",
          "postcode",
          "city"
        ],
        "type": "object",
        "properties": {
          "street": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        }
      },
      "AvailableSlot": {
        "required": [
          "id",
          "date",
          "start",
          "end"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "start": {
            "type": "string",
            "format": "time"
          },
          "end": {
            "type": "string",
            "format": "time"
          }
        }
      },
      "BookSlotRequest": {
        "required": [
          "slotId"
        ],
        "type": "object",
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "merchantOrderRef",
          "recipient",
          "address",
          "deliveryType",
          "lines"
        ],
        "type": "object",
        "properties": {
          "merchantOrderRef": {
            "type": "string"
          },
          "recipient": {
            "$ref": "#/components/schemas/RecipientRequest"
          },
          "address": {
            "$ref": "#/components/schemas/AddressRequest"
          },
          "deliveryType": {
            "$ref": "#/components/schemas/DeliveryType"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineRequest"
            }
          }
        }
      },
      "CustomerDeliveryDto": {
        "required": [
          "orderNumber",
          "status",
          "deliveryType",
          "recipientName",
          "street",
          "postcode",
          "city",
          "lines",
          "slot",
          "canChangeSlot",
          "linkValidThrough"
        ],
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/DeliveryStatus"
          },
          "deliveryType": {
            "$ref": "#/components/schemas/DeliveryType"
          },
          "recipientName": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerLineDto"
            }
          },
          "slot": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AvailableSlot"
              }
            ]
          },
          "canChangeSlot": {
            "type": "boolean"
          },
          "linkValidThrough": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CustomerLineDto": {
        "required": [
          "description",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CustomerLinkDto": {
        "required": [
          "customerLink"
        ],
        "type": "object",
        "properties": {
          "customerLink": {
            "type": "string"
          }
        }
      },
      "DayOfWeek": {
        "enum": [
          "Sunday",
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ]
      },
      "DeliveryStatus": {
        "enum": [
          "AwaitingBooking",
          "Booked",
          "Planned",
          "Loaded",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ]
      },
      "DeliveryType": {
        "enum": [
          "Curbside",
          "Doorstep"
        ]
      },
      "GenerateSlotsRequest": {
        "required": [
          "zoneId",
          "from",
          "to",
          "weekdays",
          "windows",
          "maxDeliveries"
        ],
        "type": "object",
        "properties": {
          "zoneId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "weekdays": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/DayOfWeek"
            }
          },
          "windows": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TimeWindow"
            }
          },
          "maxDeliveries": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GenerateSlotsResult": {
        "required": [
          "created",
          "skipped"
        ],
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "format": "int32"
          },
          "skipped": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GeocodeStatus": {
        "enum": [
          "Pending",
          "Ok",
          "Failed"
        ]
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "MerchantDto": {
        "required": [
          "id",
          "name",
          "apiKeyPrefix",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "apiKeyPrefix": {
